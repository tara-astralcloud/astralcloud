# Copy this to .env.local for local development — never commit .env.local
# Secrets are injected via Kubernetes Secret in production

AUTH_SECRET=your-random-secret-here
AUTH_KEYCLOAK_ID=dashboard
AUTH_KEYCLOAK_SECRET=your-client-secret-here
AUTH_KEYCLOAK_ISSUER=http://keycloak.astralcloud.local/auth/realms/astralcloud
NEXTAUTH_URL=http://localhost:3000
